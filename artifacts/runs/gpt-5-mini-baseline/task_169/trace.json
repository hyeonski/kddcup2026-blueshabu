      "thought": "Load SME customer IDs from customers.db, read yearmonth.csv, filter for 2013 and SME customers, compute mean consumption.",
      "action": "execute_python",
      "action_input": {
        "code": "import sqlite3\nimport pandas as pd\n\n# Load SME customer IDs\nconn = sqlite3.connect('db/customers.db')\ndf_customers = pd.read_sql_query(\"SELECT CustomerID, Segment FROM customers WHERE Segment='SME'\", conn)\nconn.close()\n\nsme_ids = set(df_customers['CustomerID'].astype(str).tolist())\n\n# Read yearmonth CSV\ndf = pd.read_csv('csv/yearmonth.csv', dtype={'CustomerID':str, 'Date':str, 'Consumption':float})\n# Filter for Date in 2013\nmask_year = df['Date'].str.startswith('2013')\ndf_2013 = df[mask_year]\n# Filter for SME customers\ndf_sme_2013 = df_2013[df_2013['CustomerID'].isin(sme_ids)]\n\n# Compute average monthly consumption (mean of Consumption values)\nmean_consumption = df_sme_2013['Consumption'].mean()\ncount_rows = len(df_sme_2013)\n\nprint(mean_consumption)\nprint(count_rows)"
      },
