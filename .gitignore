# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv
.python-version

# Local environment files
.env
.env.local
.env.*.local
.codex

# Local data, docs, tests, and artifacts
data/
docs/
tests/
evaluation/

# artifacts: track meta + scores + logs + predictions, skip raw traces
artifacts/*
!artifacts/.gitkeep
!artifacts/runs/
!artifacts/sweep_logs/
artifacts/runs/*
!artifacts/runs/*/
artifacts/runs/*/*
!artifacts/runs/*/summary.json
!artifacts/runs/*/score.txt
!artifacts/runs/*/run.log
!artifacts/runs/*/task_*/
artifacts/runs/*/task_*/*
!artifacts/runs/*/task_*/prediction.csv
!artifacts/runs/*/task_*/trace.json
artifacts/sweep_logs/*
!artifacts/sweep_logs/*.log

# Local configs (also track sweep configs for reproducibility)
configs/*
!configs/react_baseline.example.yaml
!configs/react_memory.example.yaml
!configs/submission.yaml
!configs/_sweep_*.yaml

# Submission tarballs (built by scripts/make_submission.sh)
*.tar
*.tar.gz

# OS / notebook noise
.DS_Store
.ipynb_checkpoints/

# Windows NTFS Alternate Data Streams (Zone.Identifier sidecar files)
*:Zone.Identifier