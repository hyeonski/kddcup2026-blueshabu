      "raw_response": "{\"thought\":\"Compute average AvgScrMath for districts with 'Riverside' in the district name using the satscores DB to identify which districts exceed 400.\",\"action\":\"execute_context_sql\",\"action_input\":{\"path\":\"db/satscores.db\",\"sql\":\"SELECT dname, AVG(AvgScrMath) as avg_math, COUNT(*) as schools FROM satscores WHERE dname LIKE '%Riverside%' GROUP BY dname HAVING avg_math > 400 ORDER BY avg_math DESC;\",\"limit\":200}}",
